# Content Multiplier - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgres://cm:cm@localhost:5432/cm

# ============================================
# LLM API KEYS
# ============================================
# OpenAI Configuration (Default provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek Configuration (Optional - for cost-effective alternative)
DEEPSEEK_API_KEY=

# Anthropic Configuration (Optional - for Claude models)
ANTHROPIC_API_KEY=

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=

# Grok Configuration (Optional - X.AI)
GROK_API_KEY=

# ============================================
# LLM MODEL SETTINGS
# ============================================
# Primary model for JSON completion (ideas, briefs, drafts)
LLM_MODEL=gpt-4o-mini
# Alternative options:
# - gpt-4o (more capable, more expensive)
# - gpt-3.5-turbo (faster, cheaper)
# - deepseek-chat (very cost-effective)
# - claude-3-5-sonnet-20241022 (Anthropic)
# - gemini-1.5-flash (Google)
# - grok-beta (X.AI)

# OpenAI-specific model settings
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding model for RAG/vector search
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# API SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API base URL for frontend (if different from localhost)
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ============================================
# RAG (Retrieval-Augmented Generation)
# ============================================
# Vector similarity threshold (0-1, lower = more lenient)
RAG_SIMILARITY_THRESHOLD=0.7
# Number of documents to retrieve
RAG_TOP_K=8

# ============================================
# TELEMETRY & LOGGING
# ============================================
# Enable detailed logging
DEBUG=false
LOG_LEVEL=info

# ============================================
# OPTIONAL: PUBLISHING INTEGRATIONS
# ============================================
# LinkedIn OAuth (for future publishing features)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Twitter/X OAuth (for future publishing features)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# Email Service Provider (for future email campaigns)
SENDGRID_API_KEY=
MAILCHIMP_API_KEY=

# CMS Integrations (for future publishing features)
WORDPRESS_API_URL=
WORDPRESS_API_KEY=

# ============================================
# NOTES
# ============================================
# 1. Never commit the actual .env file to version control
# 2. Get your OpenAI API key from: https://platform.openai.com/api-keys
# 3. For local development, the DATABASE_URL should point to localhost
# 4. Make sure PostgreSQL is running (via Docker Compose) before starting the API
# 5. The LLM_MODEL determines which AI model is used for content generation
